VERIZON_GATEWAY_URL=http://gateway.example
VERIZON_GATEWAY_PASSWORD=replace-with-your-real-password
VERIZON_GATEWAY_USERNAME=admin
VERIZON_GATEWAY_TIMEZONE=UTC
VERIZON_GATEWAY_BROWSER_CHANNEL=chrome
# Optional command hooks override the corresponding direct value.
# VERIZON_GATEWAY_PASSWORD_COMMAND=["op","read","op://your-vault/your-item/your-field"]
# VERIZON_GATEWAY_URL_COMMAND=["printf","%s","http://gateway.example"]
# Optional opt-in hardware test switch:
VERIZON_GATEWAY_LIVE_TEST=0
